# limb11/ — 11×24 signed-limb Montgomery track.
COMMON = ../common
include $(COMMON)/track.mk

# tv_ecdsa.S needs the generated bytecode
tv_ecdsa.o: bytecode.inc

# ── FAST variant: dec;jnz over `loop`, separate Fadd/Fsub (no imul). ──
tv_ecdsa_fast.o: tv_ecdsa.S bytecode.inc
	$(CC) -DFAST -c tv_ecdsa.S -o $@

.PHONY: size-fast test-fast bench-fast bench20-fast

size-fast: tv_ecdsa_fast.o
	@size tv_ecdsa_fast.o | tail -1

test-fast: tv_ecdsa_fast.o
	$(CC) $(CFLAGS) $(SANFLAGS) -I$(COMMON) -o $(TMP)_test_fast \
		tv_ecdsa_fast.o $(COMMON)/test_ecdsa_asm.c
	$(TMP)_test_fast
	$(CC) $(CFLAGS) $(SANFLAGS) -I$(COMMON) -o $(TMP)_test_wp_fast \
		tv_ecdsa_fast.o $(COMMON)/test_wycheproof_asm.c
	$(TMP)_test_wp_fast

bench-fast: tv_ecdsa_fast.o
	$(CC) -O2 -o $(TMP)_bench_fast tv_ecdsa_fast.o $(COMMON)/bench.c
	$(TMP)_bench_fast

bench20-fast: tv_ecdsa_fast.o
	$(CC) -O2 -o $(TMP)_bench_fast tv_ecdsa_fast.o $(COMMON)/bench.c
	@for i in $$(seq 1 20); do $(TMP)_bench_fast; done | sort -n | sed -n '10,11p'

clean::
	rm -f tv_ecdsa_fast.o

# ── Track-specific: fe_mul unit test, bytecode regen, range proof ──
.PHONY: test-mul regen check all

all: test size

test-mul: test_mul.c fe_mul.S vectors_mul.h
	$(CC) $(CFLAGS) $(SANFLAGS) test_mul.c fe_mul.S -o $(TMP)_test_mul
	$(TMP)_test_mul

test: test-mul

regen: bytecode.inc

bytecode.inc: $(COMMON)/gen_bytecode.py
	python3 $(COMMON)/gen_bytecode.py > $@ 2>$(TMP)_bc_check.txt
	@cat $(TMP)_bc_check.txt

check:
	python3 $(COMMON)/range_proof.py

size-mul:
	@$(CC) -c fe_mul.S -o $(TMP)_fe_mul.o
	@echo "fe_mul11:" && size $(TMP)_fe_mul.o | tail -1
