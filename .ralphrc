# .ralphrc - Ralph project configuration
# Generated by: ralph enable
# Documentation: https://github.com/frankbria/ralph-claude-code

# Project identification
PROJECT_NAME="pornin-test"
PROJECT_TYPE="asm-c"

# Claude Code CLI command
# If "claude" is not in your PATH, set to your installation:
#   "npx @anthropic-ai/claude-code"  (uses npx, no global install needed)
#   "/path/to/claude"                (custom path)
CLAUDE_CODE_CMD="claude"

# Loop settings
MAX_CALLS_PER_HOUR=500
CLAUDE_TIMEOUT_MINUTES=15
CLAUDE_OUTPUT_FORMAT="json"

# Tool permissions
# Comma-separated list of allowed tools
# Safe git subcommands only - broad Bash(git *) allows destructive commands like git clean/git rm (Issue #149)
# Project-specific: make/cargo for build+test, cc/gcc/binutils for object inspection,
# perf for benchmark diagnostics, python3 for vector gen + plotting, latex for fix_plan report task.
ALLOWED_TOOLS="Write,Read,Edit,Bash(git add *),Bash(git commit *),Bash(git diff *),Bash(git log *),Bash(git status),Bash(git status *),Bash(git push *),Bash(git pull *),Bash(git fetch *),Bash(git checkout *),Bash(git branch *),Bash(git stash *),Bash(git merge *),Bash(git tag *),Bash(git show *),Bash(make *),Bash(cargo *),Bash(cc *),Bash(gcc *),Bash(as *),Bash(size *),Bash(nm *),Bash(objdump *),Bash(readelf *),Bash(perf *),Bash(python3 *),Bash(./bench_*),Bash(./test_*),Bash(./sign_*),Bash(ls *),Bash(find *),Bash(grep *),Bash(wc *),Bash(cat *),Bash(head *),Bash(tail *),Bash(diff *),Bash(sort *),Bash(which *),Bash(file *),Bash(cd *),Bash(pdflatex *),Bash(latexmk *),Bash(xelatex *),Bash(npm *),Bash(pytest)"

# Session management
SESSION_CONTINUITY=true
SESSION_EXPIRY_HOURS=24

# Task sources (for ralph enable --sync)
# Options: local, beads, github (comma-separated for multiple)
TASK_SOURCES="github,local"
GITHUB_TASK_LABEL="ralph-task"
BEADS_FILTER="status:open"

# Circuit breaker thresholds
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=5
CB_OUTPUT_DECLINE_THRESHOLD=70

# Auto-update Claude CLI at startup
CLAUDE_AUTO_UPDATE=true
